# Copia este archivo a `.env` y rellena los valores reales.
# `.env` esta en .gitignore y NO debe subirse nunca al repositorio.

# --- Adzuna (https://developer.adzuna.com/) ---
# Una sola credencial sirve para todos los indices de pais (mx, us, ...).
ADZUNA_APP_ID=tu_app_id_aqui
ADZUNA_APP_KEY=tu_app_key_aqui

# --- Jooble (https://jooble.org/api/about) ---
# OJO: Jooble emite una API key DISTINTA por pais/dominio.
# La key de Mexico no funciona contra el indice de EE.UU. ni al reves.
# Plan gratuito: 500 peticiones DE POR VIDA por key (no mensuales).
JOOBLE_API_KEY_MX=tu_key_de_mexico_aqui
JOOBLE_API_KEY_US=tu_key_de_estados_unidos_aqui

# --- Anthropic (https://console.anthropic.com/) ---
# En producción la key es DEL USUARIO, no del desarrollador: los costes son
# suyos y transparentes, y su CV y sus datos nunca pasan por una cuenta ajena.
# El techo de gasto está en config/search_profile.yaml (bloque `llm`): no es un
# secreto, es una decisión de producto, y se versiona.
ANTHROPIC_API_KEY=sk-ant-tu_key_aqui

# --- Datos personales del usuario ---
# Fuera del codigo y fuera de la configuracion versionada.
# En la v0 no se usan todavia, pero se declaran aqui para fijar la costumbre.
CLIENT_EMAIL=placeholder@example.com
CLIENT_LINKEDIN_URL=https://www.linkedin.com/in/placeholder
